{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node scripts/copy-snapshot.mjs && expo start",
    "web": "node scripts/copy-snapshot.mjs && expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "copy-snapshot": "node scripts/copy-snapshot.mjs",
    "export:web": "node scripts/copy-snapshot.mjs && WEB_BASE_URL=${WEB_BASE_URL-/college-rankings} expo export -p web && node scripts/finish-export.mjs",
    "preview:web": "node scripts/preview-subpath.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@college/dataset": "workspace:*",
    "@college/ranking-engine": "workspace:*",
    "@expo-google-fonts/fraunces": "0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "2.117.0",
    "@tanstack/react-query": "5.103.2",
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "typescript": "~6.0.3"
  }
}
