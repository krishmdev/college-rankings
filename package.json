{
  "name": "college-rankings",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web": "pnpm --filter mobile web",
    "start": "pnpm --filter mobile start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p packages/ranking-engine && tsc -p packages/dataset && pnpm --filter mobile typecheck",
    "lint": "pnpm --filter mobile lint",
    "engine:bench": "bash scripts/bench-engine.sh",
    "engine:report": "tsx packages/ranking-engine/scripts/report.ts",
    "export:web": "pnpm --filter mobile export:web",
    "preview:web": "pnpm --filter mobile preview:web",
    "e2e": "pnpm --filter mobile e2e",
    "supabase": "supabase",
    "supabase:test": "bash scripts/supabase-test.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "fast-check": "4.10.2",
    "supabase": "2.117.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
